<Application x:Class="Reminders.Windows.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 ShutdownMode="OnExplicitShutdown">
 <Application.Resources>
  <Style TargetType="Window">
   <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/>
   <Setter Property="FontSize" Value="14"/>
   <Setter Property="Foreground" Value="#EDF0F5"/>
  </Style>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EDF0F5"/></Style>
 </Application.Resources>
</Application>
