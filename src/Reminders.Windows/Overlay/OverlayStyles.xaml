<ResourceDictionary
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Reminders.Windows.Overlay">
 <SolidColorBrush x:Key="OverlaySurfaceBrush" Color="#EB17221F"/>
 <SolidColorBrush x:Key="OverlayBorderBrush" Color="#46584E"/>
 <SolidColorBrush x:Key="OverlayTextBrush" Color="#EFF5F0"/>
 <SolidColorBrush x:Key="OverlayMutedBrush" Color="#A1B4A9"/>
 <SolidColorBrush x:Key="OverlayCheckboxBorderBrush" Color="#94B5A4"/>
 <SolidColorBrush x:Key="OverlayCheckboxHoverBrush" Color="#BFE8D2"/>
 <SolidColorBrush x:Key="OverlayCheckboxPressedBrush" Color="#94CDB0"/>
 <SolidColorBrush x:Key="OverlayCheckboxGlyphBrush" Color="#133C2A"/>

 <!-- 只有非零 alpha 才能命中分层窗口；输入层不重复绘制任何可见勾选图形。 -->
 <Style x:Key="OverlayHitButtonStyle" TargetType="Button">
  <Setter Property="OverridesDefaultStyle" Value="True"/>
  <Setter Property="Focusable" Value="False"/>
  <Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="#01000000"/></ControlTemplate></Setter.Value></Setter>
 </Style>

 <Style x:Key="OverlayCompletionButtonStyle" TargetType="{x:Type local:CompletionButton}">
  <Setter Property="Background" Value="Transparent"/>
  <Setter Property="BorderBrush" Value="{StaticResource OverlayCheckboxBorderBrush}"/>
  <Setter Property="BorderThickness" Value="1.25"/>
  <Setter Property="Foreground" Value="{StaticResource OverlayCheckboxGlyphBrush}"/>
  <Setter Property="HorizontalContentAlignment" Value="Center"/>
  <Setter Property="VerticalContentAlignment" Value="Center"/>
  <Setter Property="OverridesDefaultStyle" Value="True"/>
  <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Cursor" Value="Hand"/>
  <Setter Property="SnapsToDevicePixels" Value="True"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="{x:Type local:CompletionButton}">
     <Border x:Name="Box" Background="{TemplateBinding Background}"
      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
      CornerRadius="5">
      <Path x:Name="CheckGlyph" Data="M 1,5 L 4.3,8.3 L 10,1.7"
       Width="11" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
       Stroke="{TemplateBinding Foreground}" StrokeThickness="1.8"
       StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
       <Setter TargetName="Box" Property="Background" Value="{StaticResource OverlayCheckboxHoverBrush}"/>
       <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource OverlayCheckboxHoverBrush}"/>
       <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible"/>
      </Trigger>
      <Trigger Property="IsPreviewHovered" Value="True">
       <Setter TargetName="Box" Property="Background" Value="{StaticResource OverlayCheckboxHoverBrush}"/>
       <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource OverlayCheckboxHoverBrush}"/>
       <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
       <Setter TargetName="Box" Property="Background" Value="{StaticResource OverlayCheckboxPressedBrush}"/>
       <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource OverlayCheckboxPressedBrush}"/>
       <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible"/>
      </Trigger>
      <Trigger Property="IsPreviewPressed" Value="True">
       <Setter TargetName="Box" Property="Background" Value="{StaticResource OverlayCheckboxPressedBrush}"/>
       <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource OverlayCheckboxPressedBrush}"/>
       <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
       <Setter TargetName="Box" Property="Background" Value="#24362D"/>
       <Setter TargetName="Box" Property="BorderBrush" Value="#657C6E"/>
       <Setter TargetName="CheckGlyph" Property="Visibility" Value="Collapsed"/>
       <Setter Property="Cursor" Value="Arrow"/>
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>

 <Style x:Key="OverlayScrollThumbStyle" TargetType="Thumb">
  <Setter Property="Background" Value="#526C5E"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="Thumb">
     <Border x:Name="ThumbSurface" Background="{TemplateBinding Background}" CornerRadius="2" Margin="1,0"/>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbSurface" Property="Background" Value="#82A08D"/></Trigger>
      <Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbSurface" Property="Background" Value="#A4C5B0"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style x:Key="OverlayScrollBarStyle" TargetType="ScrollBar">
  <Setter Property="Width" Value="6"/>
  <Setter Property="Margin" Value="8,2,0,2"/>
  <Setter Property="Background" Value="#26382E"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="ScrollBar">
     <Grid Background="{TemplateBinding Background}">
      <Track x:Name="PART_Track" IsDirectionReversed="True">
       <Track.DecreaseRepeatButton>
        <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False">
         <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
        </RepeatButton>
       </Track.DecreaseRepeatButton>
       <Track.Thumb><Thumb Style="{StaticResource OverlayScrollThumbStyle}" MinHeight="24"/></Track.Thumb>
       <Track.IncreaseRepeatButton>
        <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False">
         <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
        </RepeatButton>
       </Track.IncreaseRepeatButton>
      </Track>
     </Grid>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
</ResourceDictionary>
